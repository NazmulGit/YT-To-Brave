{
  "manifest_version": 3,
  "name": "YT-to-Brave (Core) - Open YouTube in Brave",
  "short_name": "YT-to-Brave Core",
  "version": "1.0.0",
  "description": "Automatically open YouTube links in Brave (or any browser of your choice). Includes Picture-in-Picture mode with full playback controls.",
  "author": "withnazmul",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "YT-to-Brave",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/link-detector.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "tabs",
    "storage",
    "webNavigation",
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.youtu.be/*",
    "*://youtu.be/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/pip/pip.html",
        "src/pip/pip.css",
        "src/pip/pip.js",
        "icons/*.png",
        "assets/*.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open YT-to-Brave popup"
    },
    "toggle-pip": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Toggle Picture-in-Picture for current YouTube tab"
    },
    "open-current-in-brave": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Open current tab in Brave"
    }
  }
}
